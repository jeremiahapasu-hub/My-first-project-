# ---------------------------------------------------------------------------
# Pocket Signal Lab — environment
# Copy to `.env` and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (required).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pocket_analytics?schema=public"

# Secret used to sign session JWTs (required).
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string"

# How long a session stays valid. Accepts a value `jose` understands: "7d", "12h", "30m".
AUTH_SESSION_TTL="7d"

# Public origin of the app. Used for absolute URLs and cookie security decisions.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional: AI-written summaries.
# Leave OPENAI_API_KEY empty and the app falls back to its built-in deterministic
# analyser. Every number on every screen is computed locally either way — the API
# is only ever used to phrase the narrative sections.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Credentials for the seeded demo accounts. Only read by `prisma/seed.ts`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin12345"
SEED_ANALYST_EMAIL="analyst@example.com"
SEED_ANALYST_PASSWORD="analyst12345"
